# Recommended: `py run.py init` generates a private .env with random credentials.
# Set these when configuring the server directly. API keys map to trusted claims.
API_KEYS_JSON={"replace-with-a-random-api-key":{"id":"local-user","role":"admin","tenant":"local","agents":["support-agent"]}}
ADMIN_TOKEN=replace-with-a-separate-random-operator-token
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT=60
SEMANTIC_ENABLED=true
HTTP_TIMEOUT=10
HTTP_MAX_RESPONSE_BYTES=1048576
HTTP_MAX_REQUEST_BYTES=1048576
# POLICY_PATH=policies/policy.yaml
# SIGNATURE_PATH=signatures/attacks.yaml
# DATABASE_PATH=data/control.db
